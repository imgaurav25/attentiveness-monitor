# Copy this file to .env and fill in your real values before running
# `docker compose up`. See README.md "Production deployment" for the full
# walkthrough.

# Your domain, pointed at this server's IP via an A record (e.g.
# meet.example.com). Caddy uses this to automatically obtain a free
# Let's Encrypt HTTPS certificate -- required for camera access from any
# device other than the server itself.
#
# For local-only testing without a real domain, use: DOMAIN=localhost
# (camera access will then only work when browsing from this same machine).
DOMAIN=meet.example.com

# Comma-separated list of origins the backend will accept requests from.
# Must match how people actually access the site (same domain as above,
# with https://).
ALLOWED_ORIGINS=https://meet.example.com
